# ha-fleet dev secrets — copy to .env (which is git-ignored) and fill in.
#   cp .env.example .env
#
# These feed the bundled Dex dev IdP and the relay's OIDC client. They are
# DEV-ONLY throwaway values; a real deployment points OIDC_ISSUER at a company
# IdP and never uses Dex or these vars at all.

# OIDC client secret shared between Dex (staticClients[].secret) and the relay
# (OIDC_CLIENT_SECRET). Any non-empty string; change it for your own stack.
DEX_CLIENT_SECRET=ha-fleet-dev-secret

# bcrypt hash of the password for all three demo users (admin@/operator@/viewer@).
# The committed example is bcrypt("password"). MUST be single-quoted — the hash
# contains '$' segments that an unquoted value would mangle when sourced.
# Regenerate with:  htpasswd -bnBC 10 "" 'yourpassword' | tr -d ':\n'
DEX_USER_PASSWORD_HASH='$2a$10$5j6dnkdIUk/eebwzaHeu0u0Oy0fEPiuFtzHKwSNHmiYxNxQHrSQ7K'
